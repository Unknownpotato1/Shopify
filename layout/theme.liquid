<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
 <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>

<style>
@font-face {
  font-family: 'Manrope';
  src: url('https://res.cloudinary.com/drlmgjt6p/raw/upload/v1793722843/Manrope-VariableFont_wght_hoxvp0.ttf') format('truetype');
  font-weight: 200 800;
  font-style: normal;
  font-display: swap;
}

/* Apply Manrope throughout the store */
body,
body button,
body input,
body select,
body textarea {
  font-family: 'Manrope', sans-serif !important;
}

/* Headings */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Manrope', sans-serif !important;
}

/* Price elements (were using Josefin Sans) */
.price,
.compare-at-price,
.save-price-tag,
.money,
.cart-bubble__text-count {
  font-family: 'Manrope', sans-serif !important;
}
/* Product dropdown/accordion titles — match Anushka Jain look */
.details__header,
.accordion__toggle,
.accordion__title {
  font-family: 'Manrope', sans-serif !important;
  font-weight: 700 !important;
  font-size: 11px !important;
  letter-spacing: 0.105em !important;
  text-transform: uppercase !important;
  line-height: 1.3 !important;
  color: #332923 !important;
}

/* Product dropdown/accordion titles — match Anushka Jain look */
.details__header,
.accordion__toggle,
.accordion__title {
  font-family: 'Manrope', sans-serif !important;
  font-weight: 700 !important;
  font-size: 11px !important;
  letter-spacing: 0.105em !important;
  text-transform: uppercase !important;
  line-height: 1.3 !important;
  color: #543a2d !important;
}

/* Dropdown content — match Anushka Jain look */
.details__content,
.details-content,
.accordion__content,
details .rte {
  font-family: 'Manrope', sans-serif !important;
  font-weight: 400 !important;
  font-size: 11px !important;
  letter-spacing: 0.01em !important;
  line-height: 1.75 !important;
  color: #8a7b70 !important;
}
</style>
  <head>
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% # theme-check-disable ParserBlockingScript %}
    <script src="{{ 'critical.js' | asset_url }}"></script>
    {% # theme-check-enable ParserBlockingScript %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
<script>
(function () {

  function addEviolaStickyIcons() {

    const bar = document.querySelector('.smart-sticky-buy-bar');

    if (!bar || bar.querySelector('.eviola-sticky-icon')) return;

    const addButton = bar.querySelector('.smart-sticky-add');

    if (!addButton) return;

    // QUICK CHAT BUTTON
    const chat = document.createElement('button');

    chat.type = 'button';
    chat.className = 'eviola-sticky-icon';
    chat.setAttribute('aria-label', 'Quick Chat');

    chat.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none"
        stroke="#5E4231" stroke-width="1.7"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/>
        <path d="M8 10h8"/>
        <path d="M8 14h5"/>
      </svg>
    `;

   chat.addEventListener('click', function () {
  const chatWindow = document.querySelector('[data-chat-window]');

  if (chatWindow) {
    chatWindow.classList.add('show');
  }
});


    // WISHLIST BUTTON
    const wishlist = document.createElement('button');

    wishlist.type = 'button';
    wishlist.className = 'eviola-sticky-icon';
    wishlist.setAttribute('aria-label', 'Wishlist');

    wishlist.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none"
        stroke="#5E4231" stroke-width="1.7"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    `;

  wishlist.addEventListener('click', function () {

  const svg = wishlist.querySelector('svg');
  const path = svg.querySelector('path');

  const filled = wishlist.classList.toggle('heart-filled');

  svg.style.setProperty('fill', filled ? '#5E4231' : 'none', 'important');

  path.style.setProperty('fill', filled ? '#5E4231' : 'none', 'important');

});


    // INSERT ICONS BEFORE ADD TO CART
    bar.insertBefore(chat, addButton);
    bar.insertBefore(wishlist, addButton);

  }


  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', addEviolaStickyIcons);
  } else {
    addEviolaStickyIcons();
  }

  // Handle dynamically created sticky bars
  const observer = new MutationObserver(addEviolaStickyIcons);

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

})();
</script>