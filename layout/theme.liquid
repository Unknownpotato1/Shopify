<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
 <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>

<style>
@font-face {
  font-family: 'Manrope';
  src: url('https://res.cloudinary.com/drlmgjt6p/raw/upload/v1793722843/Manrope-VariableFont_wght_hoxvp0.ttf') format('truetype');
  font-weight: 200 800;
  font-style: normal;
  font-display: swap;
}

/* Apply Manrope throughout the store */
body,
body button,
body input,
body select,
body textarea {
  font-family: 'Manrope', sans-serif !important;
}

/* Headings */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Manrope', sans-serif !important;
}

/* Price elements (were using Josefin Sans) */
.price,
.compare-at-price,
.save-price-tag,
.money,
.cart-bubble__text-count {
  font-family: 'Manrope', sans-serif !important;
}
/* Product dropdown/accordion titles — match Anushka Jain look */
.details__header,
.accordion__toggle,
.accordion__title {
  font-family: 'Manrope', sans-serif !important;
  font-weight: 700 !important;
  font-size: 11px !important;
  letter-spacing: 0.105em !important;
  text-transform: uppercase !important;
  line-height: 1.3 !important;
  color: #543a2d !important;
}

/* Dropdown content — match Anushka Jain look */
.details__content,
.details-content,
.accordion__content,
details .rte {
  font-family: 'Manrope', sans-serif !important;
  font-weight: 400 !important;
  font-size: 11px !important;
  letter-spacing: 0.01em !important;
  line-height: 1.75 !important;
  color: #8a7b70 !important;
}
</style>
  <head>
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% # theme-check-disable ParserBlockingScript %}
    <script src="{{ 'critical.js' | asset_url }}"></script>
    {% # theme-check-enable ParserBlockingScript %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
<script>
(function () {

  // === Eviola sticky chat + wishlist icons ===
  // Original implementation used a body-wide MutationObserver (subtree: true)
  // that fired on every DOM mutation. On a product page, tapping a variant
  // triggers ~5 DOM mutations (variant picker morph, media-gallery replace,
  // price replace, inventory morph, ATC button morph) — so the observer fired
  // 5+ times per tap, each doing 3 full-document querySelector scans, causing
  // the freeze on mobile.
  //
  // Fix:
  //   1. Debounce the observer (rapid mutations = one callback)
  //   2. Cheap early-exit before any DOM scan
  //   3. Disconnect after icons are added (bar is rendered once)
  //   4. Re-observe briefly if the bar ever disappears (app may re-create it)

  var observer = null;
  var debounceTimer = null;

  function addEviolaStickyIcons() {
    // Cheap early-exit before any DOM scan
    if (!document.body) return;

    // Single cheap query — if no bar or icons already present, exit
    var bar = document.querySelector('.smart-sticky-buy-bar');
    if (!bar || bar.querySelector('.eviola-sticky-icon')) {
      // If we previously added icons and the bar is gone, re-arm the observer
      if (!bar && observer) { restartObserverBriefly(); }
      return;
    }

    var addButton = bar.querySelector('.smart-sticky-add');
    if (!addButton) return;

    // QUICK CHAT BUTTON
    var chat = document.createElement('button');
    chat.type = 'button';
    chat.className = 'eviola-sticky-icon';
    chat.setAttribute('aria-label', 'Quick Chat');
    chat.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none"
        stroke="#5E4231" stroke-width="1.7"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/>
        <path d="M8 10h8"/>
        <path d="M8 14h5"/>
      </svg>
    `;
    chat.addEventListener('click', function () {
      var chatWindow = document.querySelector('[data-chat-window]');
      if (chatWindow) chatWindow.classList.add('show');
    });

    // WISHLIST BUTTON
    var wishlist = document.createElement('button');
    wishlist.type = 'button';
    wishlist.className = 'eviola-sticky-icon';
    wishlist.setAttribute('aria-label', 'Wishlist');
    wishlist.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none"
        stroke="#5E4231" stroke-width="1.7"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    `;
    wishlist.addEventListener('click', function () {
      var svg = wishlist.querySelector('svg');
      var path = svg.querySelector('path');
      var filled = wishlist.classList.toggle('heart-filled');
      svg.style.setProperty('fill', filled ? '#5E4231' : 'none', 'important');
      path.style.setProperty('fill', filled ? '#5E4231' : 'none', 'important');
    });

    // INSERT ICONS BEFORE ADD TO CART
    bar.insertBefore(chat, addButton);
    bar.insertBefore(wishlist, addButton);

    // Icons added — disconnect the observer so it stops firing on every
    // subsequent DOM mutation (variant taps, scroll, etc.)
    if (observer) { observer.disconnect(); observer = null; }
  }

  // Debounced wrapper: collapses rapid mutations into a single callback.
  // The original implementation fired once per mutation; this fires once per
  // burst (e.g., one burst of variant-update mutations = one callback).
  function debouncedAddIcons() {
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(function () {
      debounceTimer = null;
      addEviolaStickyIcons();
    }, 120);
  }

  // Start (or restart) the observer. We watch body with childList + subtree
  // because the smart-sticky-buy-bar can be inserted deep in the DOM by an app.
  function startObserver() {
    if (observer) return;
    observer = new MutationObserver(debouncedAddIcons);
    observer.observe(document.body, { childList: true, subtree: true });
  }

  // If the bar disappears after we've added icons (e.g., an app re-creates it),
  // re-arm the observer for a short window to re-inject.
  function restartObserverBriefly() {
    startObserver();
    setTimeout(function () {
      if (observer) { observer.disconnect(); observer = null; }
    }, 3000);
  }

  // Initial run + start observer
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      addEviolaStickyIcons();
      // Only start the observer if icons weren't added yet (bar might appear later)
      var bar = document.querySelector('.smart-sticky-buy-bar');
      if (!bar || !bar.querySelector('.eviola-sticky-icon')) startObserver();
    });
  } else {
    addEviolaStickyIcons();
    var bar = document.querySelector('.smart-sticky-buy-bar');
    if (!bar || !bar.querySelector('.eviola-sticky-icon')) startObserver();
  }

})();
</script>