<style>

/* ============================================================
   EVIOLA FOOTER THEME
   ============================================================ */

.footer {
  --footer-primary: #543A2D;
  --footer-secondary: #8A7B70;
  --footer-background: #F8F7F4;
  --footer-border: #DCCDBB;

  background: var(--footer-background) !important;
  color: var(--footer-secondary) !important;

  padding: 32px 22px 0;
  padding-bottom: var(--eviola-sticky-footer-space, 0px);

  font-family: 'Manrope', sans-serif;
  box-sizing: border-box;

  width: 100vw !important;
  max-width: 100vw !important;
  margin-left: calc(50% - 50vw) !important;
  margin-right: calc(50% - 50vw) !important;
}


/* ============================================================
   LOGO
   ============================================================ */

.footer-logo {
  margin: 0 0 14px;
}

.footer-logo img {
  width: 180px;
  height: auto;
  display: block;
  object-fit: contain;
}


/* ============================================================
   TAGLINE
   ============================================================ */

.footer-tagline {
  font-size: 13px;
  font-weight: 400;
  color: var(--footer-secondary) !important;
  line-height: 1.65;
  margin: 0 0 38px;
  max-width: 320px;
}


/* ============================================================
   CONTACT
   ============================================================ */

.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 30px;
}

.footer .contact-row {
  display: flex;
  align-items: center;
  gap: 12px;

  font-size: 13px;
  color: var(--footer-secondary) !important;

  text-decoration: none;
  transition: color 0.2s ease;
}

.footer .contact-row:hover {
  color: var(--footer-primary) !important;
}

.footer .contact-row svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;

  stroke: var(--footer-primary) !important;
}


/* ============================================================
   LINKS
   ============================================================ */

.footer-links {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px 16px;
  margin-bottom: 28px;
}

.footer-col-title {
  font-size: 14px;
  font-weight: 700;

  color: var(--footer-primary) !important;

  margin-bottom: 14px;
  letter-spacing: 0.2px;
}

.footer-col ul {
  list-style: none;

  display: flex;
  flex-direction: column;
  gap: 11px;

  margin: 0;
  padding: 0;
}

.footer-col ul li a {
  font-size: 13px;
  font-weight: 400;

  color: var(--footer-secondary) !important;

  text-decoration: none;
  transition: color 0.2s ease;
}

.footer-col ul li a:hover {
  color: var(--footer-primary) !important;
}


/* ============================================================
   SOCIAL ICONS
   ============================================================ */

.footer-social {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 28px;
}

.footer .social-icon {
  width: 30px;
  height: 30px;
  min-width: 30px;
  min-height: 30px;

  border-radius: 50%;

  background: var(--footer-primary) !important;

  display: flex;
  align-items: center;
  justify-content: center;

  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease;

  flex-shrink: 0;
}

.footer .social-icon:hover {
  background: var(--footer-secondary) !important;
  transform: translateY(-2px);
}


/* SOCIAL SVG BASE */

.footer .social-icon svg {
  width: 17px;
  height: 17px;

  min-width: 17px;
  min-height: 17px;

  max-width: 17px;
  max-height: 17px;

  display: block;
  flex-shrink: 0;
  overflow: visible;
}


/* FACEBOOK */

.footer .social-facebook svg {
  fill: var(--footer-background);
}


/* INSTAGRAM */

.footer .social-instagram svg {
  width: 17px;
  height: 17px;
}

.footer .social-instagram rect {
  fill: none;
  stroke: var(--footer-background);
  stroke-width: 2;
}

.footer .social-instagram circle {
  fill: none;
  stroke: var(--footer-background);
  stroke-width: 2;
}

.footer .social-instagram .instagram-dot {
  fill: var(--footer-background);
  stroke: none;
}


/* X */

.footer .social-x svg {
  width: 16px;
  height: 16px;
  fill: var(--footer-background);
}


/* PINTEREST */

.footer .social-pinterest svg {
  width: 17px;
  height: 17px;
  fill: var(--footer-background);
}


/* ============================================================
   COPYRIGHT
   ============================================================ */

.footer-bottom {
  border-top: 1px solid var(--footer-border);

  text-align: center;
  padding: 14px 0;

  font-size: 12px;
  color: var(--footer-secondary) !important;

  font-weight: 400;
  margin: 0;
}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 480px) {

  .footer {
    padding-left: 20px;
    padding-right: 20px;
  }

  .footer-logo img {
    width: 170px;
  }

  .footer-tagline {
    font-size: 12.5px;
    margin-bottom: 32px;
  }

  .footer-links {
    gap: 24px 12px;
  }

}


/* ============================================================
   STICKY BUY BUTTON COMPATIBILITY
   ============================================================ */

