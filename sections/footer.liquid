<!-- ============================================================
     STICKY FOOTER SPACE SCRIPT
     ============================================================ -->

<script>

(function () {

  if (window.__eviolaFooterStickyFix) {
    return;
  }

  window.__eviolaFooterStickyFix = true;


  function getFooter() {
    return document.querySelector('.footer');
  }


  function getStickyBar() {
    return document.querySelector('.sticky-buy-buttons');
  }


  function updateFooterSpace() {

    var footer = getFooter();

    if (!footer) {
      return;
    }

    var stickyBar = getStickyBar();


    /* No sticky bar */

    if (!stickyBar) {

      footer.style.setProperty(
        '--eviola-sticky-footer-space',
        '0px'
      );

      return;
    }


    /* Check visibility */

    var isVisible =
      stickyBar.classList.contains('is-visible');


    if (!isVisible) {

      footer.style.setProperty(
        '--eviola-sticky-footer-space',
        '0px'
      );

      return;
    }


    /* Measure actual sticky bar height */

    var stickyHeight =
      stickyBar.getBoundingClientRect().height;


    if (!stickyHeight || stickyHeight < 1) {

      footer.style.setProperty(
        '--eviola-sticky-footer-space',
        '0px'
      );

      return;
    }


    /* Add exact height */

    footer.style.setProperty(
      '--eviola-sticky-footer-space',
      Math.ceil(stickyHeight) + 'px'
    );

  }


  /* Initial update */

  updateFooterSpace();


  /* Watch sticky bar changes */
  // ORIGINAL implementation observed document.documentElement with subtree:true
  // AND attributeFilter:['class','style']. This fired on EVERY class/style
  // change anywhere in the entire document — including the cascade of style
  // mutations the theme makes when morphing the variant picker, media
  // gallery, price, inventory, and ATC button on a variant tap. Each fire
  // called updateFooterSpace() which calls getBoundingClientRect() — a
  // synchronous layout reflow. The reflow itself triggers more style
  // mutations → observer fires again → infinite cascade → page freezes.
  //
  // Fix:
  //   1. Only observe the sticky bar element itself (the only thing whose
  //      `is-visible` class matters), not the whole document.
  //   2. Only watch `class` (we don't care about `style`).
  //   3. Debounce the callback so rapid mutations collapse into one.
  //   4. Read getBoundingClientRect() inside requestAnimationFrame so it
  //      never forces layout during the mutation callback.

  var footerObserverTimer = null;
  function debouncedUpdateFooterSpace() {
    if (footerObserverTimer) return;
    footerObserverTimer = setTimeout(function () {
      footerObserverTimer = null;
      requestAnimationFrame(updateFooterSpace);
    }, 120);
  }

  var footerObserver = new MutationObserver(debouncedUpdateFooterSpace);

  function attachFooterObserver() {
    var stickyBar = getStickyBar();
    if (!stickyBar) {
      // If the sticky bar isn't in the DOM yet, watch body childList for it
      // to appear. Once it does, switch to observing the sticky bar itself.
      return;
    }
    footerObserver.observe(stickyBar, {
      attributes: true,
      attributeFilter: ['class']
    });
  }

  attachFooterObserver();

  // If the sticky bar is added/removed dynamically, re-attach. Watch body
  // childList only (cheap — fires only when something is added/removed at
  // body level, not on every attribute change).
  var stickyBarWatcher = new MutationObserver(function () {
    var current = getStickyBar();
    if (current) {
      try { footerObserver.disconnect(); } catch (e) {}
      footerObserver.observe(current, {
        attributes: true,
        attributeFilter: ['class']
      });
    }
  });
  stickyBarWatcher.observe(document.body, { childList: true, subtree: false });


  /* Page load */

  window.addEventListener('load', function () {

    updateFooterSpace();

    setTimeout(updateFooterSpace, 100);
    setTimeout(updateFooterSpace, 500);
    setTimeout(updateFooterSpace, 1000);

  });


  /* Screen resize */

  window.addEventListener(
    'resize',
    updateFooterSpace,
    { passive: true }
  );


  /* Tab visibility */

  document.addEventListener(
    'visibilitychange',
    updateFooterSpace
  );


})();

</script>